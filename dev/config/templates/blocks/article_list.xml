<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>article_list</key>

    <meta>
        <title lang="en">Article List</title>
        <title lang="de">Artikelliste</title>
    </meta>

    <properties>
        <property name="title" type="text_line">
            <meta>
                <title lang="en">Section Title</title>
                <title lang="de">Abschnittstitel</title>
            </meta>
        </property>
        <property name="articles" type="smart_content">
            <meta>
                <title lang="en">Articles</title>
                <title lang="de">Artikel</title>
            </meta>
            <params>
                <param name="provider" value="articles"/>
            </params>
        </property>
    </properties>
</template>
