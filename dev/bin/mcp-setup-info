#!/usr/bin/env php
<?php

$yellow = "\e[33m";
$green = "\e[32m";
$reset = "\e[0m";

echo <<<OUTPUT

  {$yellow}sulu/mcp-server-bundle{$reset} setup:

  1. {$green}Generate OAuth keypair{$reset}
     bin/adminconsole league:oauth2-server:generate-keypair

  2. {$green}Update database schema{$reset}
     bin/adminconsole doctrine:schema:update --force

  3. {$green}Create an MCP client{$reset}
     bin/adminconsole sulu:mcp:create-client "My AI Assistant"


OUTPUT;
